# Bloquear execução de PHP na pasta de uploads
<FilesMatch "\.(php|phtml|php3|php4|php5|phps|phar)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Permitir apenas imagens e documentos seguros
<FilesMatch "\.(jpg|jpeg|png|gif|ico|pdf|doc|docx)$">
    Order allow,deny
    Allow from all
</FilesMatch>

# Forçar download de arquivos (opcional)
# <FilesMatch "\.(pdf|doc|docx)$">
#     Header set Content-Disposition attachment
# </FilesMatch>
